// StockPilot database schema.
// Normalized model derived from docs/DOMAIN.md, docs/ARCHITECTURE.md and docs/DECISIONS.md.
// This is a clean production schema — there is no legacy data to migrate (docs/DATA_MIGRATION.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth / RBAC -----------------------------------------------------------

enum Role {
  ADMIN
  STORE_MANAGER
  STORE_OPERATOR
  MAINTENANCE_USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role
  isActive     Boolean  @default(true)
  // Marks accounts created by the development seed script so they are never
  // mistaken for real production accounts. See docs/DATA_MIGRATION.md.
  isSeedUser   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]

  @@map("users")
}

// --- Equipment / department register ---------------------------------------

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machines Machine[]
  items    InventoryItem[]

  @@map("departments")
}

model Machine {
  id            String     @id @default(uuid())
  name          String
  code          String     @unique
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  cost          Decimal    @default(0) @db.Decimal(12, 2)
  vendor        String?
  warrantyUntil DateTime?  @db.Date
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  units MachineUnit[]
  items InventoryItem[]

  @@index([departmentId])
  @@map("machines")
}

model MachineUnit {
  id        String   @id @default(uuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([machineId])
  @@map("machine_units")
}

// --- Inventory catalog and stock --------------------------------------------

enum ItemCategory {
  CAPITAL_SPARES
  OPERATING_SPARES
  ROTABLE_SPARES
  CONSUMABLES
  DURABLE_TOOLS
  SAFETY_PPE
}

enum Criticality {
  VITAL
  ESSENTIAL
  DESIRABLE
}

enum UnitOfMeasure {
  EACH
  PAIR
  KG
  LITRE
  METER
  SET
}

model InventoryItem {
  id            String        @id @default(uuid())
  name          String
  sku           String        @unique
  barcode       String        @unique
  departmentId  String
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  // Nullable: an item not linked to any machine is "store inventory"
  // (reference used the 'NONE' sentinel — see docs/DOMAIN.md §5).
  machineId     String?
  machine       Machine?      @relation(fields: [machineId], references: [id], onDelete: Restrict)
  category      ItemCategory
  criticality   Criticality
  rack          String
  unitOfMeasure UnitOfMeasure
  // Authoritative on-hand balance. Must only ever be changed by the stock
  // movement application layer inside a DB transaction — see docs/BUSINESS_RULES.md §3.
  stock         Decimal       @default(0) @db.Decimal(12, 2)
  threshold     Decimal       @default(0) @db.Decimal(12, 2)
  price         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stockMovements StockMovement[]

  @@index([departmentId])
  @@index([machineId])
  @@map("inventory_items")
}

// --- Stock movements (the audit trail) --------------------------------------

enum MovementDirection {
  ADD
  CONSUME
  ADJUSTMENT
}

// Append-only ledger. Every stock quantity change must be represented by
// exactly one row here, written in the same DB transaction as the balance
// update. See docs/BUSINESS_RULES.md §2-3 and docs/ARCHITECTURE.md §3.
model StockMovement {
  id     String        @id @default(uuid())
  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  // Only ever set for CONSUME movements against a machine-linked item.
  machineUnitId String?
  machineUnit   MachineUnit? @relation(fields: [machineUnitId], references: [id], onDelete: Restrict)

  direction    MovementDirection
  // Magnitude for ADD/CONSUME (always > 0); signed delta for ADJUSTMENT
  // (may be negative). See docs/DECISIONS.md "Stock movement model".
  quantity     Decimal           @db.Decimal(12, 2)
  // Required for ADJUSTMENT, enforced in the domain layer (not a DB constraint
  // because Prisma/Postgres conditional-required-field checks add complexity
  // disproportionate to this stage — see docs/DECISIONS.md).
  reason       String?
  // Snapshot of item.stock immediately after this movement, for audit/debugging
  // convenience. Not authoritative — item.stock is authoritative.
  balanceAfter Decimal           @db.Decimal(12, 2)

  // Authoritative actor. Replaces the reference's free-text "Employee ID" —
  // see docs/DECISIONS.md "Audit identity".
  performedByUserId String
  performedBy       User    @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  // Optional, non-authoritative display label (e.g. a badge/shift code the
  // performing user wants recorded). Never used for authorization or audit
  // ownership.
  employeeLabel     String?

  // Snapshot of the shift in-charge at the time of the movement, derived from
  // ShiftInchargeEntry. Immutable once written — see docs/DOMAIN.md §6.
  inchargeId String?

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([machineUnitId])
  @@index([performedByUserId])
  @@index([createdAt])
  @@map("stock_movements")
}

// --- Shift in-charge log -----------------------------------------------------

// Append-only. Free-text roster entry, intentionally decoupled from User —
// see docs/DECISIONS.md OPEN_QUESTION on this point.
model ShiftInchargeEntry {
  id          String   @id @default(uuid())
  inchargeId  String
  effectiveAt DateTime
  createdAt   DateTime @default(now())

  @@index([effectiveAt])
  @@map("shift_incharge_log")
}
