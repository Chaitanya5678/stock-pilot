# Copy to .env and fill in local values. Never commit real secrets.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/stockpilot_dev?schema=public"

# Symmetric secret used to sign session tokens (see src/infrastructure/auth). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-random-32-byte-base64-value"
